+    /// Decoded RGB (a video's frame) through the image path from preparation on: the same resampling, token budget,
+    /// virtual ids and hold as an image's, not cached. ``rgb`` stays the caller's.
+    pub fn prepareRgb(h: *Host, a: Allocator, rgb: pixels.Rgb, problem: *parts.Problem) error{ Refused, OutOfMemory }!*Shared {
+        if (rgb.w == 0 or rgb.h == 0 or rgb.data.len != @as(usize, rgb.w) * rgb.h * 3) return refuse(problem, "a video frame's pixels are malformed");
+        if (@as(u64, rgb.w) * rgb.h > h.s.max_pixels) return refuse(problem, try std.fmt.allocPrint(a, "video frame of more than {d} pixels (TF_DSV41_VISION_MAX_PIXELS)", .{h.s.max_pixels}));
+        return h.finish(a, rgb, null, problem);
+    }
+
