+    /// Where a video part's frames come from: an opened video's frames, and how to close it.
+    pub const VideoSource = struct {
+        ctx: ?*anyopaque = null,
+        /// Video ``i``'s (0-based) part at ``url``: its bytes within main's limits (``b``), opened.
+        open: *const fn (ctx: ?*anyopaque, cx: *Cx, url: []const u8, i: usize, b: *videos.Budget, fetch: ?images_mod.Fetch) errors.Refused!Opened,
+    };
+    pub const Opened = struct { src: vision.video.Source, ctx: *anyopaque, close: *const fn (ctx: *anyopaque) void };
+
+    /// main's video path (``videos.zig``): data: or https bytes, libtfvideo, the size / length / rate checks.
+    const libtfvideo: VideoSource = .{ .open = struct {
+        fn open(_: ?*anyopaque, cx: *Cx, url: []const u8, i: usize, b: *videos.Budget, fetch: ?images_mod.Fetch) errors.Refused!Opened {
+            const bytes = try videos.bytesOf(cx, fetch, url, b);
+            const dec = try cx.a.create(videos.Decoder);
+            const src = try cx.a.create(api.VideoSource);
+            src.* = try videos.open(cx, bytes, i, dec);
+            return .{ .src = .{ .frames = src.frames, .rate_num = src.rate_num, .rate_den = src.rate_den, .ctx = src, .decode = decode }, .ctx = dec, .close = close };
+        }
+        fn decode(ctx: *anyopaque, indices: []const u32, sink: vision.video.Sink) anyerror!void {
+            const src: *api.VideoSource = @ptrCast(@alignCast(ctx));
+            return src.decode(src.ctx, indices, .{ .ctx = sink.ctx, .take = sink.take });
+        }
+        fn close(ctx: *anyopaque) void {
+            const dec: *videos.Decoder = @ptrCast(@alignCast(ctx));
+            dec.v.close();
+        }
+    }.open };
