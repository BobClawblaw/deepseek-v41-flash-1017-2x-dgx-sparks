+
+/// A fake video for the render tests: ``frames`` solid 8 x 6 frames at ``fps``, rows padded to 32 bytes.
+const FakeVideo = struct {
+    frames: u64 = 60,
+    fps: u64 = 30,
+    opened: usize = 0,
+    closed: usize = 0,
+
+    fn source(f: *FakeVideo) DeepSeek.VideoSource {
+        return .{ .ctx = f, .open = open };
+    }
+    fn open(ctx: ?*anyopaque, _: *Cx, _: []const u8, _: usize, _: *videos.Budget, _: ?images_mod.Fetch) errors.Refused!DeepSeek.Opened {
+        const f: *FakeVideo = @ptrCast(@alignCast(ctx.?));
+        f.opened += 1;
+        return .{ .src = .{ .frames = f.frames, .rate_num = f.fps, .rate_den = 1, .ctx = f, .decode = decode }, .ctx = f, .close = close };
+    }
+    fn decode(_: *anyopaque, indices: []const u32, sink: vision.video.Sink) anyerror!void {
+        var buf: [32 * 6]u8 = undefined;
+        for (indices, 0..) |idx, k| {
+            @memset(&buf, @truncate(idx * 5));
+            try sink.take(sink.ctx, k, &buf, 8, 6, 32);
+        }
+    }
+    fn close(ctx: *anyopaque) void {
+        const f: *FakeVideo = @ptrCast(@alignCast(ctx));
+        f.closed += 1;
+    }
+};
+
+/// A native DeepSeek side over the mini tokenizer with a test host (image id 1003) and ``max_images``.
+fn nativeForTest(gpa: Allocator, tok: *tokenizer.Tokenizer, max_images: u32) !*DeepSeek {
+    const d = try DeepSeek.init(gpa, tok, .{ .images = .native });
+    const vh = try gpa.create(vision.host.Host);
+    vh.* = vision.host.Host.init(gpa, std.testing.io, .{ .image_token = 1003, .max_images = max_images });
+    d.vision = vh;
+    d.io = std.testing.io;
+    return d;
+}
