+test "a video part under TF_DSV41_IMAGES=placeholder reads as the image notice; under reject it is refused" {
+    const gpa = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    var cx: Cx = .{ .a = arena.allocator() };
+    const tok = try serve.tokenizer.Tokenizer.parse(gpa, serve.fixtures.mini_tokenizer);
+    defer tok.deinit();
+    const messages = try userParts(cx.a, video_part);
+    const placeholder = try DeepSeek.init(gpa, tok, .{});
+    defer placeholder.deinit(false);
+    const got = try placeholder.family_().render(&cx, .{ .messages = messages, .tools = &.{}, .thinking = false, .effort = "high", .body = .null });
+    try std.testing.expectEqual(@as(u32, 1), got.images_omitted);
+    try std.testing.expect(got.images == null);
+    try std.testing.expect(std.mem.indexOf(u8, try tok.decodeAlloc(cx.a, got.ids), "what happens\n\n" ++ image_text) != null);
+    const reject = try DeepSeek.init(gpa, tok, .{ .images = .reject });
+    defer reject.deinit(false);
+    try std.testing.expectError(error.Refused, reject.family_().render(&cx, .{ .messages = messages, .tools = &.{}, .thinking = false, .effort = "high", .body = .null }));
+    try std.testing.expectEqualStrings("messages[0].content: videos are not served by this DeepSeek-V4.1 build", cx.message);
+}
