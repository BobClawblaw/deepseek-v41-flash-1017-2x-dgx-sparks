+test "TF_DSV41_IMAGES=native: video limits, and no libtfvideo refused with main's message" {
+    const gpa = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    var cx: Cx = .{ .a = arena.allocator() };
+    const tok = try serve.tokenizer.Tokenizer.parse(gpa, serve.fixtures.mini_tokenizer);
+    defer tok.deinit();
+    const d = try nativeForTest(gpa, tok, 1);
+    defer d.deinit(false);
+    var fake: FakeVideo = .{};
+    d.video_source = fake.source();
+    const p: family.Prompt = .{ .messages = try userParts(cx.a, video_part ++ "," ++ image_part), .tools = &.{}, .thinking = false, .effort = "high", .body = .null };
+    try std.testing.expectError(error.Refused, d.family_().render(&cx, p));
+    try std.testing.expectEqualStrings("2 images and videos in one request: at most 1 (TF_DSV41_VISION_MAX_IMAGES; a video's frames count as images)", cx.message);
+    const three: family.Prompt = .{ .messages = try userParts(cx.a, video_part ++ "," ++ video_part ++ "," ++ video_part), .tools = &.{}, .thinking = false, .effort = "high", .body = .null };
+    try std.testing.expectError(error.Refused, d.family_().render(&cx, three));
+    try std.testing.expectEqualStrings("a request supports at most 2 videos", cx.message);
+    try std.testing.expectEqual(@as(usize, 0), fake.opened);
+    // a video alone takes the whole count: one frame here (TF_DSV41_VISION_MAX_IMAGES=1)
+    const one = try d.family_().render(&cx, .{ .messages = try userParts(cx.a, video_part), .tools = &.{}, .thinking = false, .effort = "high", .body = .null });
+    const im = one.images orelse return error.NoImages;
+    defer im.release();
+    try std.testing.expectEqual(@as(u64, 1), @as(*const vision.held.Held, @ptrCast(@alignCast(im.held))).n);
+    // libtfvideo itself: absent on the test host, the request is refused with main's words
+    if (api.tfvideo.version() == null) {
+        d.video_source = DeepSeek.libtfvideo;
+        try std.testing.expectError(error.Refused, d.family_().render(&cx, .{ .messages = try userParts(cx.a, video_part), .tools = &.{}, .thinking = false, .effort = "high", .body = .null }));
+        try std.testing.expect(std.mem.startsWith(u8, cx.message, "video input needs libtfvideo (FFmpeg) beside the server"));
+    }
+}
