+test "TF_DSV41_IMAGES=native: a video part is its frames, each a timestamp then its image span, within the image count" {
+    const gpa = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    var cx: Cx = .{ .a = arena.allocator() };
+    const tok = try serve.tokenizer.Tokenizer.parse(gpa, serve.fixtures.mini_tokenizer);
+    defer tok.deinit();
+    // 4 images a request, one of them an image: the 2 s video's 4 frames (2 a second) capped at 3
+    const d = try nativeForTest(gpa, tok, 4);
+    defer d.deinit(false);
+    var fake: FakeVideo = .{};
+    d.video_source = fake.source();
+    const got = try d.family_().render(&cx, .{ .messages = try userParts(cx.a, video_part ++ "," ++ image_part), .tools = &.{}, .thinking = false, .effort = "high", .body = .null });
+    const im = got.images orelse return error.NoImages;
+    defer im.release();
+    try std.testing.expectEqual(@as(usize, 1), fake.opened);
+    try std.testing.expectEqual(@as(usize, 1), fake.closed);
+    const h: *const vision.held.Held = @ptrCast(@alignCast(im.held));
+    try std.testing.expectEqual(@as(u64, 4), h.n); // 3 frames then the image, in prompt order
+    // the spans in order, each frame's preceded by its time: frames 10, 30, 50 of 60 at 30 fps
+    const want = [_][]const u8{ "0.3 seconds\n", "1.0 seconds\n", "1.7 seconds\n", "\n\n" };
+    var at: usize = 0;
+    for (h.slice(), want) |img, w| {
+        const start = std.mem.indexOfScalarPos(u32, got.ids, at, img.vids[0]) orelse return error.NoSpan;
+        try std.testing.expectEqualSlices(u32, img.vids[0..img.n_vids], got.ids[start .. start + img.n_vids]);
+        const before = try tok.decodeAlloc(cx.a, got.ids[at..start]);
+        try std.testing.expect(std.mem.endsWith(u8, before, w));
+        at = start + img.n_vids;
+    }
+    for (got.ids) |t| try std.testing.expect(t != 1003); // every placeholder expanded
+    try std.testing.expect(!std.mem.eql(u8, &h.slice()[0].digest, &h.slice()[1].digest));
+    // frame text alone: main's videos.seconds, a line a frame
+    try std.testing.expectEqualStrings("0.2 seconds\n" ++ vision.parts.IMAGE_PLACEHOLDER ++ "\n149.3 seconds\n" ++ vision.parts.IMAGE_PLACEHOLDER, try DeepSeek.frameText(cx.a, &.{ 0.25, 149.3 }));
+}
