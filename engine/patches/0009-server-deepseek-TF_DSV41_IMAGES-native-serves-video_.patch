+    /// A rendered prompt with video parts (and maybe images): each video's frames sampled and prepared as images,
+    /// its sentinel as ``<t> seconds`` and an image placeholder a frame; then the images; one slot for them all.
+    fn renderFrames(d: *DeepSeek, cx: *Cx, vh: *vision.host.Host, marker: *vision.parts.Marker, prompt: []const u8) errors.Refused!family.Rendered {
+        const a = cx.a;
+        var vp: vision.parts.Problem = .{};
+        if (marker.problem) |p| return cx.refuse(p);
+        const n_parts = marker.urls.items.len;
+        var n_videos: usize = 0;
+        for (marker.videos.items) |v| n_videos += @intFromBool(v);
+        const n_images = n_parts - n_videos;
+        if (n_videos > videos.max_videos) return cx.refuse(try std.fmt.allocPrint(a, "a request supports at most {d} videos", .{videos.max_videos}));
+        const max = vh.s.max_images;
+        if (n_parts > max) return cx.refuse(try std.fmt.allocPrint(a, "{d} images and videos in one request: at most {d} (TF_DSV41_VISION_MAX_IMAGES; a video's frames count as images)", .{ n_parts, max }));
+        vh.enter(&vp) catch return cx.fail(.capacity, "{s}", .{vp.message});
+        defer vh.leave();
+        var owned: std.ArrayList(*vision.host.Shared) = .empty; // everything held so far, released on a refusal
+        var handed = false;
+        errdefer if (!handed) vh.releaseAll(owned.items);
+        const texts = try a.alloc(?[]const u8, n_parts);
+        @memset(texts, null);
+        const frames_of = try a.alloc([]const *vision.host.Shared, n_parts);
+        var left: usize = max - n_images; // frames the request's image count leaves, shared evenly by its videos
+        var videos_left = n_videos;
+        var vi: usize = 0;
+        var bytes_left: videos.Budget = .{ .deadline = std.Io.Clock.awake.now(d.io.?).addDuration(.fromSeconds(videos.total_s)) };
+        const fetch: ?images_mod.Fetch = if (vh.s.fetch) images_mod.Fetch.network(d.io.?) else null;
+        for (marker.urls.items, marker.videos.items, 0..) |url, is_video, i| {
+            if (!is_video) continue;
+            const cap: u32 = @intCast(@min(vh.s.video_max_frames, left / videos_left));
+            if (!std.ascii.startsWithIgnoreCase(url, "data:") and std.mem.startsWith(u8, url, "https://") and fetch == null)
+                return cx.refuse("this server does not fetch video URLs (TF_DSV41_VISION_FETCH=0): send a data: URL");
+            const op = try d.video_source.open(d.video_source.ctx, cx, url, vi, &bytes_left, fetch);
+            defer op.close(op.ctx);
+            const fr = vision.video.prepare(vh, a, op.src, cap, &vp) catch |e| return switch (e) {
+                error.OutOfMemory => error.OutOfMemory,
+                error.Refused => cx.refuse(try std.fmt.allocPrint(a, "video {d}: {s}", .{ vi + 1, vp.message })),
+                error.NoFrames => cx.refuse(try std.fmt.allocPrint(a, "video {d}: the video's frame count or rate is missing", .{vi + 1})),
+                error.Undecodable => cx.refuse(try videos.invalid(cx, vi)),
+            };
+            try owned.appendSlice(a, fr.shared);
+            frames_of[i] = fr.shared;
+            texts[i] = try frameText(a, fr.times);
+            left -= fr.shared.len;
+            videos_left -= 1;
+            vi += 1;
+        }
+        const sp = marker.spliceWith(prompt, texts, &vp) catch |e| switch (e) {
+            error.OutOfMemory => return error.OutOfMemory,
+            error.Refused => return cx.refuse(vp.message),
+        };
+        const ids = try d.tok.encodeAlloc(a, sp.text);
+        const until = vh.deadline();
+        var shared: std.ArrayList(*vision.host.Shared) = .empty; // prompt order: an image, or a video's frames
+        for (sp.order) |i| {
+            if (marker.videos.items[i]) {
+                try shared.appendSlice(a, frames_of[i]);
+                continue;
+            }
+            const e = vh.prepare(a, marker.urls.items[i], until, &vp) catch |err| switch (err) {
+                error.OutOfMemory => return error.OutOfMemory,
+                error.Refused => return cx.refuse(vp.message),
+            };
+            owned.append(a, e) catch |err| {
+                vh.release(e);
+                return err;
+            };
+            try shared.append(a, e);
+        }
+        handed = true;
+        return holdImages(cx, vh, ids, shared.items);
+    }
+
+    /// A video's frames in the prompt: ``<t> seconds`` (main's ``videos.seconds``) then the image placeholder, a line
+    /// a frame.
+    pub fn frameText(a: Allocator, times: []const f64) Allocator.Error![]const u8 {
+        var out: std.ArrayList(u8) = .empty;
+        for (times, 0..) |t, k| {
+            if (k > 0) try out.append(a, '\n');
+            var buf: [64]u8 = undefined;
+            try out.appendSlice(a, videos.seconds(&buf, t) catch unreachable); // within videos.max_seconds
+            try out.append(a, '\n');
+            try out.appendSlice(a, vision.parts.IMAGE_PLACEHOLDER);
+        }
+        return out.items;
+    }
+
+    /// The prepared images (prompt order) held for the request (released on a refusal), the prompt's placeholders
+    /// expanded to their virtual ids.
+    fn holdImages(cx: *Cx, vh: *vision.host.Host, ids: []const u32, shared: []const *vision.host.Shared) errors.Refused!family.Rendered {
+        const a = cx.a;
+        var vp: vision.parts.Problem = .{};
+        const hold = a.create(Hold) catch |e| {
+            vh.releaseAll(shared);
+            return e;
+        };
         hold.* = .{ .vh = vh, .shared = shared };
         errdefer hold.release();
         const preps = try a.alloc(vision.prep.Prepared, shared.len);
@@ -373,6 +482,33 @@ pub const DeepSeek = struct {
