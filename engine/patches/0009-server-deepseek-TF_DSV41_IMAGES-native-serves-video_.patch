+const video_part = "{\"type\":\"video_url\",\"video_url\":{\"url\":\"data:video/mp4;base64,AAAA\"}}";
+const image_part = "{\"type\":\"image_url\",\"image_url\":{\"url\":\"data:image/png;base64," ++ test_png ++ "\"}}";
+
+fn userParts(a: Allocator, comptime parts_json: []const u8) !Value {
+    return (try json.parseText(a, "[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"what happens\"}," ++ parts_json ++ "]}]")).ok;
+}
