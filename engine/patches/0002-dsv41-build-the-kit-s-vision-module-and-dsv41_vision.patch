+struct DispatchFormat;
+struct TokenDispatchFormat;
+
+using Format = std::variant<
+    ConstStringFormat,
+    JSONSchemaFormat,
+    AnyTextFormat,
+    GrammarFormat,
+    RegexFormat,
+    SequenceFormat,
+    OrFormat,
+    TagFormat,
+    TriggeredTagsFormat,
