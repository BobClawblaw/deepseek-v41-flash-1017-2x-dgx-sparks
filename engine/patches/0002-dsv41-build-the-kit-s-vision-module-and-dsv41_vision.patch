+int32_t JSONSchemaConverter::RuleRef(const std::string& rule_name) {
+  int32_t rule_id = builder_.GetRuleId(rule_name);
+  XGRAMMAR_CHECK(rule_id != -1) << "Rule " << rule_name << " is not allocated";
