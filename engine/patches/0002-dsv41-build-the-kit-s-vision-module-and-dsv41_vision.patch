+int32_t JSONSchemaConverter::RuleRef(int32_t rule_id) {
+  auto it = rule_ref_expr_ids_.find(rule_id);
+  if (it != rule_ref_expr_ids_.end()) {
+    return it->second;
+  }
+  int32_t expr_id = builder_.AddRuleRef(rule_id);
+  rule_ref_expr_ids_[rule_id] = expr_id;
+  return expr_id;
